# DEUK Agents Platform — Environment Template
# Copy to .env and fill in values. .env is gitignored.
# All vars are optional in local dev (DEUK_ENV=local).
# In staging/prod, at least one LLM API key is required.

# ─── Core ─────────────────────────────────────────────────────────────────────
DEUK_ENV=local
# Options: local | dev | staging | prod

# ─── LLM Provider ─────────────────────────────────────────────────────────────
# Which provider to use. Default: openrouter (recommended — one key, many models)
DEUK_LLM_PROVIDER=openrouter
# Options: openrouter | openai | anthropic | custom

# Override the provider base URL (e.g. for local Ollama: http://localhost:11434/v1)
# DEUK_LLM_BASE_URL=https://openrouter.ai/api/v1

# API keys — provide the one matching your DEUK_LLM_PROVIDER
# Get OpenRouter key: https://openrouter.ai/keys
# IMPORTANT: Enable "Do not use my data for training" on every key in the dashboard.
OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ─── Budget ───────────────────────────────────────────────────────────────────
DAILY_BUDGET_USD=6.67
MONTHLY_BUDGET_USD=200
HARD_BUDGET_USD=300

# ─── Model Allowlist ──────────────────────────────────────────────────────────
# Comma-separated. Defaults to all models in ALLOWED_MODELS from @deuk/config.
# Override to restrict to specific models:
# ALLOWED_MODELS=deepseek/deepseek-v4-pro,anthropic/claude-sonnet-4.6,google/gemini-2.5-flash

# ─── Gateway Policy ───────────────────────────────────────────────────────────
RATE_LIMIT_RPM=60
REQUIRE_NO_TRAINING_HEADERS=true
SCRUBBER_PATTERNS=credit_card,ssn,api_key,email

# ─── Workers ──────────────────────────────────────────────────────────────────
MAX_CONCURRENT_WORKERS=3

# ─── AWS (only needed when DEUK_ENV != local) ─────────────────────────────────
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
S3_AUDIT_BUCKET=deuk-audit-local
# AWS credentials: prefer ~/.aws/credentials or IAM roles. Do NOT commit keys.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── GitHub ───────────────────────────────────────────────────────────────────
GH_ORG=deuk-agents
GH_REPO=deuk-agents-platform
# Fine-grained PAT with: contents:write, pull_requests:write, metadata:read
# GH_TOKEN=github_pat_...

# ─── GitHub Actions Runner ────────────────────────────────────────────────────
RUNNER_NAME=deuk-laptop-sandbox
RUNNER_LABELS=self-hosted,linux,x64,sandbox

# ─── Postgres (dev only; staging/prod use Aurora Serverless) ──────────────────
POSTGRES_PASSWORD=deuk-local-dev

# ─── Audit Shipper ────────────────────────────────────────────────────────────
AUDIT_SINK_TYPE=local
# Options: local | s3

# ─── Bitwarden (optional — for secrets management) ────────────────────────────
# BW_CLIENTID=
# BW_CLIENTSECRET=
# BW_PASSWORD=
