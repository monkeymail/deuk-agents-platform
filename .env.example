# DEUK Agents Platform — Environment Template
# Copy to .env and fill in values. .env is gitignored.

# ─── Core ───
DEUK_ENV=local

# ─── OpenRouter ───
# Get from https://openrouter.ai/keys
# IMPORTANT: Enable "Do not use my data for training" for every key.
OPENROUTER_API_KEY=sk-or-v1-...

# ─── Budgets ───
DAILY_BUDGET_USD=6.67
MONTHLY_BUDGET_USD=200
HARD_BUDGET_USD=300

# ─── Model Allowlist (comma-separated) ───
ALLOWED_MODELS=openai/gpt-4o-mini,openai/gpt-4o,anthropic/claude-3.5-sonnet

# ─── AWS (local dev uses dummy values or ~/.aws profiles) ───
AWS_REGION=eu-west-1
AWS_DEFAULT_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=      # prefer profiles; do not commit
# AWS_SECRET_ACCESS_KEY=  # prefer profiles; do not commit

# ─── S3 Audit ───
S3_AUDIT_BUCKET=deuk-audit-local
AUDIT_SINK_TYPE=local

# ─── Postgres (dev only) ───
POSTGRES_PASSWORD=deuk-local-dev

# ─── GitHub Runner ───
GH_ORG=deuk-agents
GH_REPO=platform
# GH_TOKEN=ghp_...   # classic PAT with repo + workflow scope; do not commit
RUNNER_NAME=deuk-laptop-sandbox
RUNNER_LABELS=self-hosted,linux,x64,sandbox

# ─── Bitwarden (optional) ───
# BW_CLIENTID=
# BW_CLIENTSECRET=
# BW_PASSWORD=
